#!/usr/bin/env bash
#
# hash_ls - list SHA256 hases of files in a folder,
#           with optional VirusTotal lookups.

human_size() {
    local bytes=$1
    local divisor
    local unit

    if (( bytes >= 1024 ** 3 )); then
        divisor=$(( 1024 ** 3 ))
        unit="GB"
    elif (( bytes >= 1024 ** 2 )); then
        divisor=$(( 1024 ** 2 ))
        unit="MB"
    elif (( bytes >= 1024 )); then
        divisor=1024
        unit="KB"
    else
        printf '%d B' "$bytes"
        return
    fi

    local tenths=$(( bytes * 10 / divisor ))
    printf '%d.%d %s' $(( tenths / 10 )) $(( tenths % 10 )) "$unit"
}

fmt='%3s  %-64s  %10s  %s\n'
printf "$fmt" "#" "SHA256" "Size" "FileName"
i=0
hashes=()
names=()
for file in *; do
    if [[ -f "$file" ]]; then
    hash=$(sha256sum < "$file" | cut -d ' ' -f 1)
    size=$(wc -c < "$file")
    pretty_size=$(human_size "$size")
    i=$((i + 1))
    printf "$fmt" "$i" "$hash" "$pretty_size" "$file"
    hashes+=("$hash")
    names+=("$file")
    fi 
done
while true; do
    echo
    read -rp "Enter a file # to check on VirusTotal (Q to quit): " choice || break
    if [[ "$choice" == [Qq] ]]; then
        break
    fi
    if [[ ! "$choice" =~ ^[1-9][0-9]*$ ]] || (( choice > ${#names[@]} )); then
        echo "Invalid selection."
        continue
    fi
    index=$(( choice - 1 ))
    echo "You picked ${names[$index]}"
    echo "SHA256: ${hashes[$index]}"
done


