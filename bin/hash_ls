#!/usr/bin/env bash
#
# hash_ls - list SHA256 hashes of files in a folder,
#           with optional VirusTotal lookups.
#
# Only the HASH is ever sent to VirusTotal, never the file itself.
# The API key is read from the VT_API_KEY environment variable, or from
# ~/.config/bash-toolkit/vt_api_key (created on first run, readable only by you).
#
# Works on Linux and macOS (including macOS's built-in bash 3.2).

# Stop with an error if the script uses a variable that was never set.
# This catches typos like $hases instead of $hashes.
set -u

VT_API_KEY=${VT_API_KEY:-}

red='\033[31m'
yellow='\033[33m'
green='\033[32m'
reset='\033[0m'

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/bash-toolkit"
key_file="$config_dir/vt_api_key"

say() {
    printf '%b%s%b\n' "$1" "$2" "$reset"
}

# --- Dependency checks -------------------------------------------------------

# Linux has sha256sum; macOS has shasum instead.
if command -v sha256sum > /dev/null; then
    hash_tool="sha256sum"
elif command -v shasum > /dev/null; then
    hash_tool="shasum"
else
    say "$red" "Neither sha256sum nor shasum was found - cannot hash files."
    exit 1
fi

# curl and jq are only needed for VirusTotal lookups, so a missing one
# disables lookups instead of stopping the whole script.
lookups_available=true
for tool in curl jq; do
    if ! command -v "$tool" > /dev/null; then
        say "$yellow" "$tool is not installed - VirusTotal lookups are disabled."
        say "$yellow" "Install it with: sudo pacman -S $tool (Arch) / brew install $tool (macOS)"
        lookups_available=false
    fi
done

# --- Functions ---------------------------------------------------------------

sha256_of() {
    if [[ "$hash_tool" == "sha256sum" ]]; then
        sha256sum < "$1" | cut -d ' ' -f 1
    else
        shasum -a 256 < "$1" | cut -d ' ' -f 1
    fi
}

human_size() {
    local bytes=$1
    local divisor
    local unit

    if (( bytes >= 1024 ** 3 )); then
        divisor=$(( 1024 ** 3 ))
        unit="GB"
    elif (( bytes >= 1024 ** 2 )); then
        divisor=$(( 1024 ** 2 ))
        unit="MB"
    elif (( bytes >= 1024 )); then
        divisor=1024
        unit="KB"
    else
        printf '%d B' "$bytes"
        return
    fi

    local tenths=$(( bytes * 10 / divisor ))
    printf '%d.%d %s' $(( tenths / 10 )) $(( tenths % 10 )) "$unit"
}

get_vt_key() {
    local entered

    if [[ -n "$VT_API_KEY" ]]; then
        return
    fi

    if [[ -r "$key_file" ]]; then
        VT_API_KEY=$(< "$key_file")
        return
    fi

    echo "No VirusTotal API key found. Get a free key at virustotal.com (profile > API key)."
    read -rsp "Paste your API key to enable lookups, or press Enter to skip: " entered
    echo

    if [[ -n "$entered" ]]; then
        (umask 077; mkdir -p "$config_dir"; printf '%s' "$entered" > "$key_file")
        VT_API_KEY=$entered
        say "$green" "Key saved to $key_file"
    fi
}

vt_lookup() {
    local hash=$1
    local response
    local status
    local body
    local malicious
    local suspicious
    local total
    local color

    if [[ "$lookups_available" == false ]]; then
        say "$yellow" "Lookups disabled (curl or jq missing)."
        return
    fi

    if [[ -z "$VT_API_KEY" ]]; then
        say "$yellow" "No API key - skipping detection stats."
        return
    fi

    response=$(curl -s -w '%{http_code}' -H "x-apikey: $VT_API_KEY" "https://www.virustotal.com/api/v3/files/$hash")
    status=${response: -3}
    body=${response%???}

    case "$status" in
        200)
            malicious=$(printf '%s' "$body" | jq '.data.attributes.last_analysis_stats.malicious')
            suspicious=$(printf '%s' "$body" | jq '.data.attributes.last_analysis_stats.suspicious')
            total=$(printf '%s' "$body" | jq '.data.attributes.last_analysis_stats | .malicious + .suspicious + .undetected + .harmless')
            if (( malicious > 0 )); then
                color=$red
            elif (( suspicious > 0 )); then
                color=$yellow
            else
                color=$green
            fi
            say "$color" "$malicious/$total engines flagged malicious, $suspicious suspicious"
            ;;
        404)
            say "$yellow" "Not in VirusTotal's database - unknown to VT, which is NOT the same as clean."
            ;;
        401)
            say "$red" "API key rejected. To re-enter it, delete $key_file and run hash_ls again."
            ;;
        429)
            say "$yellow" "Rate limited (free tier: 4 lookups/minute). Wait a moment and retry."
            ;;
        *)
            say "$red" "Lookup failed (HTTP status $status)."
            ;;
    esac
}

open_url() {
    local url=$1

    if command -v xdg-open > /dev/null; then
        xdg-open "$url" > /dev/null 2>&1 &
    elif command -v open > /dev/null; then
        open "$url"
    else
        echo "Open this link in your browser: $url"
    fi
}

# --- Hash table --------------------------------------------------------------

fmt='%3s  %-64s  %10s  %s\n'
i=0
key_checked=false
hashes=()
names=()

for file in *; do
    if [[ -f "$file" ]]; then
        if (( i == 0 )); then
            printf "$fmt" "#" "SHA256" "Size" "FileName"
        fi
        i=$((i + 1))
        if [[ -r "$file" ]]; then
            hash=$(sha256_of "$file")
            # $(( )) also strips the padding spaces macOS's wc adds.
            size=$(( $(wc -c < "$file") ))
            printf "$fmt" "$i" "$hash" "$(human_size "$size")" "$file"
        else
            hash=""
            printf "$fmt" "$i" "ACCESS DENIED" "?" "$file"
        fi
        hashes+=("$hash")
        names+=("$file")
    fi
done

if (( i == 0 )); then
    say "$yellow" "[!] No files found in this folder."
    exit 0
fi

# --- Lookup loop -------------------------------------------------------------

while true; do
    echo
    read -rp "Enter a file # to check on VirusTotal (Q to quit): " choice || break
    if [[ "$choice" == [Qq] ]]; then
        break
    fi
    if [[ ! "$choice" =~ ^[1-9][0-9]*$ ]] || (( choice > ${#names[@]} )); then
        echo "Invalid selection."
        continue
    fi
    index=$(( choice - 1 ))

    if [[ -z "${hashes[$index]}" ]]; then
        say "$yellow" "That file could not be read, so there is nothing to look up."
        continue
    fi

    if [[ "$key_checked" == false && "$lookups_available" == true ]]; then
        get_vt_key
        key_checked=true
    fi

    echo "Checking ${names[$index]}..."
    vt_lookup "${hashes[$index]}"
    read -rp "Open full report in browser? (y/n): " open_answer || break
    if [[ "$open_answer" == [Yy] ]]; then
        open_url "https://www.virustotal.com/gui/file/${hashes[$index]}"
    fi
done
