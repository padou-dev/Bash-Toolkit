#!/usr/bin/env bash
#
# hash_ls - list SHA256 hashes of files in a folder,
#           with optional VirusTotal lookups.

human_size() {
    local bytes=$1
    local divisor
    local unit

    if (( bytes >= 1024 ** 3 )); then
        divisor=$(( 1024 ** 3 ))
        unit="GB"
    elif (( bytes >= 1024 ** 2 )); then
        divisor=$(( 1024 ** 2 ))
        unit="MB"
    elif (( bytes >= 1024 )); then
        divisor=1024
        unit="KB"
    else
        printf '%d B' "$bytes"
        return
    fi

    local tenths=$(( bytes * 10 / divisor ))
    printf '%d.%d %s' $(( tenths / 10 )) $(( tenths % 10 )) "$unit"
}

red='\033[31m'
yellow='\033[33m'
green='\033[32m'
reset='\033[0m'

say() {
    printf '%b%s%b\n' "$1" "$2" "$reset"
}

vt_lookup() {
    local hash=$1
    local response
    local status
    local body
    local malicious
    local suspicious
    local total
    local color

    if [[ -z "$VT_API_KEY" ]]; then
        say "$yellow" "No API key - skipping detection stats."
        return
    fi

    response=$(curl -s -w '%{http_code}' -H "x-apikey: $VT_API_KEY" "https://www.virustotal.com/api/v3/files/$hash")
    status=${response: -3}
    body=${response%???}

    case "$status" in
        200)
            malicious=$(printf '%s' "$body" | jq '.data.attributes.last_analysis_stats.malicious')
            suspicious=$(printf '%s' "$body" | jq '.data.attributes.last_analysis_stats.suspicious')
            total=$(printf '%s' "$body" | jq '.data.attributes.last_analysis_stats | .malicious + .suspicious + .undetected + .harmless')
            if (( malicious > 0 )); then
                color=$red
            elif (( suspicious > 0 )); then
                color=$yellow
            else
                color=$green
            fi
            say "$color" "$malicious/$total engines flagged malicious, $suspicious suspicious"
            ;;
        404)
            say "$yellow" "Not in VirusTotal's database - unknown to VT, which is NOT the same as clean."
            ;;
        401)
            say "$red" "API key rejected. Check your VT_API_KEY."
            ;;
        429)
            say "$yellow" "Rate limited (free tier: 4 lookups/minute). Wait a moment and retry."
            ;;
        *)
            say "$red" "Lookup failed (HTTP status $status)."
            ;;
    esac
}

open_url() {
    local url=$1

    if command -v xdg-open > /dev/null; then
        xdg-open "$url" > /dev/null 2>&1 &
    elif command -v open > /dev/null; then
        open "$url"
    else
        echo "Open this link in your browser: $url"
    fi
}

fmt='%3s  %-64s  %10s  %s\n'
printf "$fmt" "#" "SHA256" "Size" "FileName"
i=0
hashes=()
names=()
for file in *; do
    if [[ -f "$file" ]]; then
        hash=$(sha256sum < "$file" | cut -d ' ' -f 1)
        size=$(wc -c < "$file")
        pretty_size=$(human_size "$size")
        i=$((i + 1))
        printf "$fmt" "$i" "$hash" "$pretty_size" "$file"
        hashes+=("$hash")
        names+=("$file")
    fi
done

while true; do
    echo
    read -rp "Enter a file # to check on VirusTotal (Q to quit): " choice || break
    if [[ "$choice" == [Qq] ]]; then
        break
    fi
    if [[ ! "$choice" =~ ^[1-9][0-9]*$ ]] || (( choice > ${#names[@]} )); then
        echo "Invalid selection."
        continue
    fi
    index=$(( choice - 1 ))
    echo "Checking ${names[$index]}..."
    vt_lookup "${hashes[$index]}"
    read -rp "Open full report in browser? (y/n): " open_answer || break
    if [[ "$open_answer" == [Yy] ]]; then
        open_url "https://www.virustotal.com/gui/file/${hashes[$index]}"
    fi
done
